{
    "name": "alengo/sulu-translated-media-bundle",
    "description": "SEO-friendly translated media filenames for Sulu CMS",
    "type": "symfony-bundle",
    "homepage": "https://github.com/alengodev/SuluBlockSettingsBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Huber-De Monte"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.13",
        "sulu/sulu": "~2.6",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/string": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "jackalope/jackalope-doctrine-dbal": "^1.10 || ^2.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\SuluTranslatedMediaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alengo\\SuluTranslatedMediaBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    }
}
